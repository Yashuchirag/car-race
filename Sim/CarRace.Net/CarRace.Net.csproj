<Project Sdk="Microsoft.NET.Sdk">
  <!-- netstandard2.1, like the rest of the simulation side, so it drops into Unity
       unchanged. It holds the sockets too (LanHost, LanClient, LanBrowser): they
       use only System.Net, which Unity has, so the game runs the same networking
       code the harness tests rather than a second copy of it. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>CarRace.Net</AssemblyName>
    <RootNamespace>CarRace.Net</RootNamespace>
  </PropertyGroup>
</Project>
