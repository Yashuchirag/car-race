<Project Sdk="Microsoft.NET.Sdk">
  <!-- netstandard2.1 so these sources drop straight into Unity 6 unchanged.
       The library has no engine dependency: it computes forces, and the caller
       (the harness here, a Rigidbody in Unity) applies and integrates them. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>CarRace.Vehicle</AssemblyName>
    <RootNamespace>CarRace.Vehicle</RootNamespace>
  </PropertyGroup>
</Project>
